{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gradstudio.org/content/section-v1.schema.json",
  "title": "GradStudio section manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "course_id", "title", "slug", "order", "status", "access"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "section" },
    "id": { "type": "string", "pattern": "^section-[a-z0-9][a-z0-9-]{2,63}$" },
    "course_id": { "type": "string", "pattern": "^course-[a-z0-9][a-z0-9-]{2,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "description": { "type": "string", "maxLength": 2000 },
    "order": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "status": { "enum": ["draft", "published", "unpublished", "retired"] },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display"],
      "properties": {
        "display": { "enum": ["open", "locked"] },
        "entitlement_key": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 100 }
      },
      "if": { "properties": { "display": { "const": "locked" } } },
      "then": { "properties": { "entitlement_key": {} }, "required": ["entitlement_key"] }
    },
    "redirect_from": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  }
}
