{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gradstudio.org/content/simulation-v1.schema.json",
  "title": "GradStudio simulation manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "course_id", "section_id", "title", "slug", "order", "status", "access", "entrypoint", "capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "simulation" },
    "id": { "type": "string", "pattern": "^sim-[a-z0-9][a-z0-9-]{2,63}$" },
    "course_id": { "type": "string", "pattern": "^course-[a-z0-9][a-z0-9-]{2,63}$" },
    "section_id": { "type": "string", "pattern": "^section-[a-z0-9][a-z0-9-]{2,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "description": { "type": "string", "maxLength": 2000 },
    "order": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "status": { "enum": ["draft", "published", "unpublished", "retired"] },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display"],
      "properties": {
        "display": { "enum": ["open", "locked"] },
        "entitlement_key": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 100 }
      },
      "if": { "properties": { "display": { "const": "locked" } } },
      "then": { "properties": { "entitlement_key": {} }, "required": ["entitlement_key"] }
    },
    "entrypoint": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+\\.html$", "maxLength": 200 },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 500,
      "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+$", "maxLength": 200 }
    },
    "shared_asset_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^asset-[a-z0-9][a-z0-9-]{2,63}$" }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_origins"],
      "properties": {
        "network_origins": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "redirect_from": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    }
  }
}
