{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gradstudio.org/content/asset-pack-v1.schema.json",
  "title": "GradStudio shared asset pack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "title", "order", "status", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "asset-pack" },
    "id": { "type": "string", "pattern": "^asset-[a-z0-9][a-z0-9-]{2,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "order": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "status": { "enum": ["draft", "published", "unpublished", "retired"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+\\.(?:css|json|png|jpe?g|gif|webp|svg|woff2?)$",
        "maxLength": 200
      }
    }
  }
}
